<?xml version="1.0" ?>

<sdf version="1.9">

  <world name="tianma_world">

    <!-- ========================= -->
    <!-- Simulation systems        -->
    <!-- ========================= -->

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>


    <!-- ========================= -->
    <!-- Lighting                  -->
    <!-- ========================= -->

    <light type="directional" name="sun">

      <pose>
        0 0 10 0 0 0
      </pose>

      <diffuse>
        0.8 0.8 0.8 1
      </diffuse>

      <specular>
        0.2 0.2 0.2 1
      </specular>

      <direction>
        -0.5 0.1 -0.9
      </direction>

    </light>


    <!-- ========================= -->
    <!-- Ground                    -->
    <!-- ========================= -->

    <model name="ground">

      <static>true</static>

      <pose>
        0 0 -0.05 0 0 0
      </pose>

      <link name="ground_link">

        <collision name="ground_collision">

          <geometry>

            <box>
              <size>
                20 20 0.1
              </size>
            </box>

          </geometry>

        </collision>


        <visual name="ground_visual">

          <geometry>

            <box>
              <size>
                20 20 0.1
              </size>
            </box>

          </geometry>

          <material>

            <ambient>
              0.35 0.35 0.35 1
            </ambient>

            <diffuse>
              0.45 0.45 0.45 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ========================= -->
    <!-- Tianma rover              -->
    <!-- ========================= -->

    <model name="tianma_rover">

      <!-- Chassis -->

      <link name="chassis">

        <pose>
          0 0 0.22 0 0 0
        </pose>

        <inertial>

          <mass>8.0</mass>

          <inertia>
            <ixx>0.193</ixx>
            <iyy>0.453</iyy>
            <izz>0.593</izz>

            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>

        </inertial>


        <collision name="chassis_collision">

          <geometry>

            <box>
              <size>
                0.8 0.5 0.2
              </size>
            </box>

          </geometry>

        </collision>


        <visual name="chassis_visual">

          <geometry>

            <box>
              <size>
                0.8 0.5 0.2
              </size>
            </box>

          </geometry>

          <material>

            <ambient>
              0.08 0.12 0.10 1
            </ambient>

            <diffuse>
              0.10 0.18 0.14 1
            </diffuse>

          </material>

        </visual>


        <!-- RGB + Depth camera -->

        <sensor
          name="front_rgbd"
          type="rgbd_camera">

          <pose>
            0.43 0 0.05 0 0 0
          </pose>

          <camera>

            <horizontal_fov>
              1.047
            </horizontal_fov>

            <image>
              <width>640</width>
              <height>480</height>
            </image>

            <clip>
              <near>0.1</near>
              <far>20.0</far>
            </clip>

          </camera>

          <always_on>true</always_on>

          <update_rate>
            15
          </update_rate>

          <visualize>true</visualize>

          <topic>
            tianma/front_rgbd
          </topic>

        </sensor>

      </link>


      <!-- Left wheel -->

      <link name="left_wheel">

        <pose relative_to="chassis">
          0 0.29 -0.12 1.5708 0 0
        </pose>

        <inertial>

          <mass>0.8</mass>

          <inertia>
            <ixx>0.0033</ixx>
            <iyy>0.0058</iyy>
            <izz>0.0033</izz>

            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>

        </inertial>

        <collision name="collision">

          <geometry>

            <cylinder>
              <radius>0.12</radius>
              <length>0.08</length>
            </cylinder>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <cylinder>
              <radius>0.12</radius>
              <length>0.08</length>
            </cylinder>

          </geometry>

        </visual>

      </link>


      <!-- Right wheel -->

      <link name="right_wheel">

        <pose relative_to="chassis">
          0 -0.29 -0.12 1.5708 0 0
        </pose>

        <inertial>

          <mass>0.8</mass>

          <inertia>
            <ixx>0.0033</ixx>
            <iyy>0.0058</iyy>
            <izz>0.0033</izz>

            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>

        </inertial>

        <collision name="collision">

          <geometry>

            <cylinder>
              <radius>0.12</radius>
              <length>0.08</length>
            </cylinder>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <cylinder>
              <radius>0.12</radius>
              <length>0.08</length>
            </cylinder>

          </geometry>

        </visual>

      </link>


      <!-- Rear caster -->

      <link name="caster">

        <pose>
          -0.30 0 0.06 0 0 0
        </pose>

        <inertial>

          <mass>0.2</mass>

          <inertia>
            <ixx>0.000288</ixx>
            <iyy>0.000288</iyy>
            <izz>0.000288</izz>

            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>

        </inertial>

        <collision name="collision">

          <geometry>

            <sphere>
              <radius>0.06</radius>
            </sphere>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <sphere>
              <radius>0.06</radius>
            </sphere>

          </geometry>

        </visual>

      </link>


      <!-- Wheel joints -->

      <joint
        name="left_wheel_joint"
        type="revolute">

        <pose relative_to="left_wheel"/>

        <parent>
            chassis
        </parent>

        <child>
            left_wheel
        </child>

        <axis>
            <xyz expressed_in="__model__">
            0 1 0
            </xyz>
        </axis>

        </joint>


      <joint
        name="right_wheel_joint"
        type="revolute">

        <pose relative_to="right_wheel"/>

        <parent>
            chassis
        </parent>

        <child>
            right_wheel
        </child>

        <axis>
            <xyz expressed_in="__model__">
            0 1 0
            </xyz>
        </axis>

        </joint>


      <joint
        name="caster_joint"
        type="fixed">

        <parent>
          chassis
        </parent>

        <child>
          caster
        </child>

      </joint>


      <!-- Differential drive -->

      <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">

        <left_joint>
          left_wheel_joint
        </left_joint>

        <right_joint>
          right_wheel_joint
        </right_joint>

        <wheel_separation>
          0.58
        </wheel_separation>

        <wheel_radius>
          0.12
        </wheel_radius>

        <odom_publish_frequency>
          10
        </odom_publish_frequency>

        <topic>
          /cmd_vel
        </topic>

      </plugin>

    </model>


    <!-- ========================= -->
    <!-- Obstacle                  -->
    <!-- ========================= -->

    <model name="obstacle">

      <static>true</static>

      <pose>
        2.5 0.3 0.5 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>
                0.8 0.8 1.0
              </size>
            </box>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <box>
              <size>
                0.8 0.8 1.0
              </size>
            </box>

          </geometry>

        </visual>

      </link>

    </model>


    <!-- ========================= -->
    <!-- Red box                   -->
    <!-- ========================= -->

    <model name="red_box">

      <static>true</static>

      <pose>
        4 1.5 0.4 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>
                0.8 0.8 0.8
              </size>
            </box>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <box>
              <size>
                0.8 0.8 0.8
              </size>
            </box>

          </geometry>

          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================= -->
    <!-- Blue cylinder             -->
    <!-- ========================= -->

    <model name="blue_cylinder">

      <static>true</static>

      <pose>
        5 -1.2 0.5 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <cylinder>
              <radius>0.35</radius>
              <length>1.0</length>
            </cylinder>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <cylinder>
              <radius>0.35</radius>
              <length>1.0</length>
            </cylinder>

          </geometry>

          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================= -->
    <!-- Red cylinder              -->
    <!-- ========================= -->

    <model name="red_cylinder">

      <static>true</static>

      <pose>
        6 1.0 0.5 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <cylinder>
              <radius>0.35</radius>
              <length>1.0</length>
            </cylinder>

          </geometry>

        </collision>

        <visual name="visual">

          <geometry>

            <cylinder>
              <radius>0.35</radius>
              <length>1.0</length>
            </cylinder>

          </geometry>

          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>

        </visual>

      </link>

    </model>


    <!-- ========================= -->
    <!-- Restricted zone           -->
    <!-- visual only               -->
    <!-- ========================= -->

    <model name="restricted_zone">

      <static>true</static>

      <pose>
        3 -2 0.01 0 0 0
      </pose>

      <link name="link">

        <visual name="restricted_visual">

          <geometry>

            <box>
              <size>
                3 2 0.02
              </size>
            </box>

          </geometry>

          <transparency>
            0.55
          </transparency>

          <material>
            <ambient>1 0 0 0.45</ambient>
            <diffuse>1 0 0 0.45</diffuse>
          </material>

        </visual>

      </link>

    </model>


  </world>

</sdf>